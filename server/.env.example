# Copy this file to ".env" and fill in your own values.

# Port the Express server listens on
PORT=5000

# MongoDB connection string
#  - Local MongoDB:   mongodb://127.0.0.1:27017/expense_tracker
#  - MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/expense_tracker
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker

# "production" makes Express serve the built React app from client/dist
NODE_ENV=development
